# git-hunk environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# OpenAI (or compatible) API key.
# Required for LLM-powered summaries (git hunk generate).
GIT_HUNK_API_KEY=

# LLM model to use. Defaults to gpt-4o-mini.
GIT_HUNK_MODEL=gpt-4o-mini

# Set to "true" to automatically run 'git hunk generate' on every commit.
# This requires the hooks to be installed: git hunk install-hooks
GIT_HUNK_AUTO_GENERATE=false
